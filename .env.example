# ===========================================
# AIeGator Environment Configuration
# ===========================================

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/aiegator
REDIS_URL=redis://localhost:6379

# API Keys - Event Platforms
EVENTBRITE_API_KEY=
EVENTBRITE_PRIVATE_TOKEN=
TICKETMASTER_API_KEY=
YELP_API_KEY=
ALLEVENTS_API_KEY=
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=
BANDSINTOWN_APP_ID=

# AI Services
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Vector Database (optional - can use pgvector instead)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=

# Application
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Collector Settings
COLLECTOR_BATCH_SIZE=100
COLLECTOR_INTERVAL_MS=300000
DEFAULT_CITY=San Francisco
DEFAULT_RADIUS_MILES=25

# Logging
LOG_LEVEL=debug
