{
  "name": "@aiegator/database",
  "version": "0.1.0",
  "description": "Database schema and migrations for AIeGator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@aiegator/shared": "*",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.11.0",
    "pgvector": "^0.1.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
